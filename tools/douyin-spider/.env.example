APP_NAME=DouyinSpider
APP_ENV=dev
APP_DEBUG=true
APP_URL=http://localhost:8080

# MySQL 数据库配置
DB_DRIVER=pdo_mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=douyin_spider
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# JWT 密钥（修改为随机字符串，长度不少于 32 位）
JWT_SECRET=change-this-to-a-random-string-with-at-least-32-chars
JWT_TTL=60
JWT_REFRESH_TTL=10080

# CORS 跨域配置
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With
CORS_ALLOW_CREDENTIALS=false
