{
    "openapi": "3.0.0",
    "info": {
        "title": "slim-lab API",
        "description": "原生 PHP 项目迁移至 Slim 4 后的接口文档。统一响应信封：`{\"code\": 0, \"message\": \"success\", \"data\": ...}`，`code` 非 0 时等于 HTTP 状态码（400 参数\/业务错误、401 未登录、405 方法不允许、404 未知模块\/未知操作、500 服务器错误）。鉴权有两种：平台接口（\/api\/auth、\/api\/logs）用 Bearer Token；clouddrive 模块基于 PHP Session（Cookie: PHPSESSID）。",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "\/",
            "description": "当前部署（相对地址）"
        }
    ],
    "paths": {
        "\/api\/auth\/register": {
            "get": {
                "tags": [
                    "Auth"
                ],
                "summary": "注册账号",
                "operationId": "bba4a3135b763ec936bcdda39e629488",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application\/json": {
                            "schema": {
                                "required": [
                                    "username",
                                    "password"
                                ],
                                "properties": {
                                    "username": {
                                        "type": "string",
                                        "example": "demo_user"
                                    },
                                    "password": {
                                        "type": "string",
                                        "example": "secret123"
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "demo@test.com"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "注册成功"
                    },
                    "400": {
                        "description": "参数错误"
                    },
                    "429": {
                        "description": "请求过于频繁"
                    },
                    "500": {
                        "description": "服务器错误"
                    }
                }
            }
        },
        "\/api\/auth\/login": {
            "get": {
                "tags": [
                    "Auth"
                ],
                "summary": "登录获取令牌",
                "operationId": "756342a72b526a9561720a3c4d81f1da",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application\/json": {
                            "schema": {
                                "required": [
                                    "username",
                                    "password"
                                ],
                                "properties": {
                                    "username": {
                                        "type": "string",
                                        "example": "demo_user"
                                    },
                                    "password": {
                                        "type": "string",
                                        "example": "secret123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "登录成功",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "$ref": "#\/components\/schemas\/AuthTokenData"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "参数错误"
                    },
                    "429": {
                        "description": "请求过于频繁"
                    },
                    "500": {
                        "description": "服务器错误"
                    }
                }
            }
        },
        "\/api\/auth\/logout": {
            "get": {
                "tags": [
                    "Auth"
                ],
                "summary": "退出登录",
                "operationId": "0b53504a7c5b7fbc89616c0b80e20aaf",
                "responses": {
                    "200": {
                        "description": "已退出登录"
                    },
                    "401": {
                        "description": "未登录"
                    },
                    "500": {
                        "description": "服务器错误"
                    }
                },
                "security": [
                    {
                        "BearerAuth": []
                    }
                ]
            }
        },
        "\/api\/auth\/userInfo": {
            "get": {
                "tags": [
                    "Auth"
                ],
                "summary": "获取当前用户信息",
                "operationId": "11392d8d113b146031cb651790b4243d",
                "responses": {
                    "200": {
                        "description": "成功",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "$ref": "#\/components\/schemas\/AuthUserWrap"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "未登录"
                    },
                    "500": {
                        "description": "服务器错误"
                    }
                },
                "security": [
                    {
                        "BearerAuth": []
                    }
                ]
            }
        },
        "\/api\/clouddrive": {
            "get": {
                "tags": [
                    "CloudDrive"
                ],
                "summary": "网盘操作（读接口与文件流）",
                "operationId": "84b036a70743130ff5b64bf0e0f96f4d",
                "parameters": [
                    {
                        "name": "action",
                        "in": "query",
                        "description": "操作类型",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "login",
                                "logout",
                                "check",
                                "list_dir",
                                "download",
                                "zip",
                                "stream",
                                "share_info",
                                "upload",
                                "mkdir",
                                "delete",
                                "rename",
                                "move"
                            ],
                            "example": "list_dir"
                        }
                    },
                    {
                        "name": "pwd",
                        "in": "query",
                        "description": "密码（login 时）",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "dir",
                        "in": "query",
                        "description": "目录路径（list_dir 时）",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "file",
                        "in": "query",
                        "description": "文件名（download\/stream 时）",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "成功",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "$ref": "#\/components\/schemas\/CloudDriveGetData"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "未登录"
                    },
                    "405": {
                        "description": "方法不允许"
                    },
                    "500": {
                        "description": "服务器错误"
                    }
                },
                "security": [
                    {
                        "SessionCookie": []
                    }
                ]
            }
        },
        "\/api\/doctrine": {
            "get": {
                "tags": [
                    "Doctrine"
                ],
                "summary": "Doctrine ORM 演示",
                "operationId": "4276b57980cb289e791e1c0ab10a3063",
                "parameters": [
                    {
                        "name": "action",
                        "in": "query",
                        "description": "演示项",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "init",
                                "create_users",
                                "create_products",
                                "find_user",
                                "dql_query",
                                "join_query",
                                "update_user",
                                "delete_product",
                                "repository",
                                "count",
                                "transaction",
                                "stats"
                            ],
                            "example": "stats"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "成功",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "$ref": "#\/components\/schemas\/DoctrineData"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "未知操作"
                    },
                    "500": {
                        "description": "服务器错误"
                    }
                }
            }
        },
        "\/api\/legacy\/{module}": {
            "get": {
                "tags": [
                    "Legacy"
                ],
                "summary": "旧版接口兼容入口",
                "operationId": "6d419c40771a364cb3682e8e582b961c",
                "parameters": [
                    {
                        "name": "module",
                        "in": "path",
                        "description": "模块名：php\/doctrine\/clouddrive",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "成功"
                    },
                    "404": {
                        "description": "未知模块"
                    }
                }
            }
        },
        "\/api\/logs\/days": {
            "get": {
                "tags": [
                    "Logs"
                ],
                "summary": "列出可查的日志日期",
                "operationId": "efc3a521b85e62d7d57b7c0d687c5020",
                "parameters": [
                    {
                        "name": "limit",
                        "in": "query",
                        "description": "最多返回的天数",
                        "schema": {
                            "type": "integer",
                            "default": 30,
                            "maximum": 90
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "成功",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "$ref": "#\/components\/schemas\/LogDaysData"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "未登录"
                    },
                    "500": {
                        "description": "服务器错误"
                    }
                },
                "security": [
                    {
                        "BearerAuth": []
                    }
                ]
            }
        },
        "\/api\/logs": {
            "get": {
                "tags": [
                    "Logs"
                ],
                "summary": "分页读取某一天的日志",
                "operationId": "0aa1a8c5b6ee61f1c22bb25143543613",
                "parameters": [
                    {
                        "name": "date",
                        "in": "query",
                        "description": "日志日期 YYYY-MM-DD",
                        "schema": {
                            "type": "string",
                            "format": "date"
                        }
                    },
                    {
                        "name": "offset",
                        "in": "query",
                        "description": "起始行号",
                        "schema": {
                            "type": "integer",
                            "default": 0,
                            "minimum": 0
                        }
                    },
                    {
                        "name": "limit",
                        "in": "query",
                        "description": "本页最大行数",
                        "schema": {
                            "type": "integer",
                            "default": 500,
                            "maximum": 2000
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "成功",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "$ref": "#\/components\/schemas\/LogData"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "未登录"
                    },
                    "500": {
                        "description": "服务器错误"
                    }
                },
                "security": [
                    {
                        "BearerAuth": []
                    }
                ]
            }
        },
        "\/api\/php-demo": {
            "get": {
                "tags": [
                    "PHP Demo"
                ],
                "summary": "PHP 演示",
                "operationId": "43ce6caa9fb350514f9c85a7bf080d29",
                "parameters": [
                    {
                        "name": "action",
                        "in": "query",
                        "description": "演示项",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "array_ops",
                                "string_ops",
                                "date_ops",
                                "json_ops",
                                "regex_ops",
                                "file_ops",
                                "random_ops",
                                "filter_ops",
                                "closure_ops"
                            ],
                            "example": "array_ops"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "成功",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "$ref": "#\/components\/schemas\/PhpDemoData"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "未知操作"
                    },
                    "500": {
                        "description": "服务器错误"
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "ApiEnvelope": {
                "properties": {
                    "code": {
                        "description": "OpenAPI 组件：统一响应信封（与 apiSuccess\/apiError 的 JSON 结构一致）。",
                        "type": "integer",
                        "example": 0
                    },
                    "message": {
                        "type": "string",
                        "example": "success"
                    },
                    "data": {
                        "example": null,
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "AuthTokenData": {
                "properties": {
                    "token": {
                        "description": "OpenAPI 组件：auth login 返回的令牌数据。",
                        "type": "string",
                        "example": "9f86d081884c7d659a2feaa0c55ad0159f86d081884c7d659a2feaa0c55ad015"
                    },
                    "user": {
                        "$ref": "#\/components\/schemas\/AuthUser"
                    }
                },
                "type": "object"
            },
            "AuthUser": {
                "properties": {
                    "id": {
                        "description": "OpenAPI 组件：认证用户信息。",
                        "type": "string",
                        "example": "json:1"
                    },
                    "username": {
                        "type": "string",
                        "example": "demo_user"
                    },
                    "email": {
                        "type": "string",
                        "example": "demo@test.com"
                    }
                },
                "type": "object"
            },
            "AuthUserWrap": {
                "properties": {
                    "user": {
                        "$ref": "#\/components\/schemas\/AuthUser"
                    }
                },
                "type": "object"
            },
            "CloudDriveGetData": {
                "oneOf": [
                    {
                        "$ref": "#\/components\/schemas\/LoginData"
                    },
                    {
                        "$ref": "#\/components\/schemas\/ShareListData"
                    },
                    {
                        "$ref": "#\/components\/schemas\/DirListData"
                    }
                ]
            },
            "CloudDrivePostData": {
                "properties": {
                    "message": {
                        "description": "OpenAPI 组件：网盘创建\/更新数据。",
                        "type": "string",
                        "example": "上传成功"
                    }
                },
                "type": "object"
            },
            "CloudDrivePostForm": {
                "properties": {
                    "action": {
                        "description": "OpenAPI 组件：网盘通用表单结构。",
                        "type": "string",
                        "example": "login"
                    },
                    "pwd": {
                        "type": "string",
                        "example": "123456"
                    },
                    "kw": {
                        "type": "string",
                        "example": "test"
                    },
                    "dir": {
                        "type": "string",
                        "example": "docs"
                    },
                    "token": {
                        "type": "string",
                        "example": "9f86d081884c7d659a2feaa0c55ad015"
                    },
                    "share_pwd": {
                        "type": "string",
                        "example": "gm0mmf"
                    },
                    "share_file": {
                        "type": "string",
                        "example": "speedtest-master.zip"
                    },
                    "is_dir_share": {
                        "type": "string",
                        "example": "0"
                    },
                    "share_expire": {
                        "type": "integer",
                        "example": 7
                    }
                },
                "type": "object"
            },
            "CloudDriveUploadForm": {
                "properties": {
                    "action": {
                        "description": "OpenAPI 组件：网盘上传表单结构。",
                        "type": "string",
                        "example": "upload"
                    },
                    "current_folder": {
                        "type": "string",
                        "example": "docs"
                    },
                    "relative_path": {
                        "type": "string",
                        "example": ""
                    },
                    "file": {
                        "type": "string",
                        "format": "binary"
                    }
                },
                "type": "object"
            },
            "DirListData": {
                "properties": {
                    "list": {
                        "description": "OpenAPI 组件：网盘目录列表数据。",
                        "type": "array",
                        "items": {
                            "$ref": "#\/components\/schemas\/FileEntry"
                        }
                    },
                    "dirs": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "example": [
                            "photos",
                            "docs\/work"
                        ]
                    },
                    "current_folder": {
                        "type": "string",
                        "example": "docs"
                    }
                },
                "type": "object"
            },
            "DoctrineData": {
                "oneOf": [
                    {
                        "$ref": "#\/components\/schemas\/MessageData"
                    },
                    {
                        "$ref": "#\/components\/schemas\/DoctrineStatsData"
                    }
                ]
            },
            "DoctrineStatsData": {
                "properties": {
                    "users": {
                        "description": "OpenAPI 组件：doctrine stats 数据。",
                        "type": "integer",
                        "example": 10
                    },
                    "products": {
                        "type": "integer",
                        "example": 50
                    }
                },
                "type": "object"
            },
            "FileEntry": {
                "properties": {
                    "name": {
                        "description": "OpenAPI 组件：网盘文件条目。",
                        "type": "string",
                        "example": "speedtest-master.zip"
                    },
                    "size": {
                        "type": "integer",
                        "example": 1234567
                    },
                    "mtime": {
                        "type": "string",
                        "example": "2026-09-08 10:00:00"
                    },
                    "isDir": {
                        "type": "boolean",
                        "example": false
                    }
                },
                "type": "object"
            },
            "LegacyModuleData": {
                "properties": {
                    "message": {
                        "description": "OpenAPI 组件：旧版模块数据。",
                        "type": "string",
                        "example": "success"
                    }
                },
                "type": "object"
            },
            "LogData": {
                "properties": {
                    "date": {
                        "description": "OpenAPI 组件：日志查询数据。",
                        "type": "string",
                        "example": "2026-09-08"
                    },
                    "total": {
                        "type": "integer",
                        "example": 1234
                    },
                    "offset": {
                        "type": "integer",
                        "example": 0
                    },
                    "limit": {
                        "type": "integer",
                        "example": 500
                    },
                    "truncated": {
                        "type": "boolean",
                        "example": false
                    },
                    "lines": {
                        "type": "array",
                        "items": {
                            "$ref": "#\/components\/schemas\/LogLine"
                        }
                    }
                },
                "type": "object"
            },
            "LogDay": {
                "properties": {
                    "date": {
                        "description": "OpenAPI 组件：单个日志日期信息。",
                        "type": "string",
                        "example": "2026-09-08"
                    },
                    "bytes": {
                        "type": "integer",
                        "example": 12345
                    }
                },
                "type": "object"
            },
            "LogDaysData": {
                "properties": {
                    "days": {
                        "description": "OpenAPI 组件：日志日期列表数据。",
                        "type": "array",
                        "items": {
                            "$ref": "#\/components\/schemas\/LogDay"
                        }
                    }
                },
                "type": "object"
            },
            "LogLine": {
                "properties": {
                    "no": {
                        "description": "OpenAPI 组件：日志行数据。",
                        "type": "integer",
                        "example": 1234
                    },
                    "timestamp": {
                        "type": "string",
                        "example": "2026-09-08 08:31:02",
                        "nullable": true
                    },
                    "channel": {
                        "type": "string",
                        "example": "app",
                        "nullable": true
                    },
                    "level": {
                        "type": "string",
                        "example": "INFO",
                        "nullable": true
                    },
                    "message": {
                        "type": "string",
                        "example": "GET \/api\/logs 200"
                    },
                    "context": {
                        "type": "object",
                        "example": null,
                        "nullable": true
                    },
                    "raw": {
                        "type": "string",
                        "example": "[2026-09-08 08:31:02] app.INFO: GET \/api\/logs 200 {\"rid\":\"1a2b3c4d\"}"
                    }
                },
                "type": "object"
            },
            "LoginData": {
                "properties": {
                    "userId": {
                        "description": "OpenAPI 组件：login 返回的登录数据。",
                        "type": "string",
                        "example": "json:1"
                    },
                    "username": {
                        "type": "string",
                        "example": "demo_user"
                    }
                },
                "type": "object"
            },
            "MessageData": {
                "properties": {
                    "message": {
                        "description": "OpenAPI 组件：消息数据。",
                        "type": "string",
                        "example": "success"
                    }
                },
                "type": "object"
            },
            "PhpDemoData": {
                "properties": {
                    "message": {
                        "description": "OpenAPI 组件：php-demo 数据。",
                        "type": "string",
                        "example": "{\"key\":\"value\"}"
                    }
                },
                "type": "object"
            },
            "SearchEntry": {
                "properties": {
                    "name": {
                        "description": "OpenAPI 组件：网盘搜索条目。",
                        "type": "string",
                        "example": "speedtest-master.zip"
                    },
                    "path": {
                        "type": "string",
                        "example": "docs\/speedtest-master.zip"
                    },
                    "size": {
                        "type": "integer",
                        "example": 1234567
                    }
                },
                "type": "object"
            },
            "SearchListData": {
                "properties": {
                    "items": {
                        "description": "OpenAPI 组件：网盘搜索结果列表。",
                        "type": "array",
                        "items": {
                            "$ref": "#\/components\/schemas\/SearchEntry"
                        }
                    }
                },
                "type": "object"
            },
            "ShareCreateData": {
                "properties": {
                    "token": {
                        "description": "OpenAPI 组件：网盘分享创建数据。",
                        "type": "string",
                        "example": "9f86d081884c7d659a2feaa0c55ad015"
                    },
                    "name": {
                        "type": "string",
                        "example": "speedtest-master.zip"
                    },
                    "url": {
                        "type": "string",
                        "example": "http:\/\/localhost:5200\/api\/clouddrive?action=share_info&token=9f86d081884c7d659a2feaa0c55ad015"
                    }
                },
                "type": "object"
            },
            "ShareEntry": {
                "properties": {
                    "token": {
                        "description": "OpenAPI 组件：网盘分享条目。",
                        "type": "string",
                        "example": "9f86d081884c7d659a2feaa0c55ad015"
                    },
                    "name": {
                        "type": "string",
                        "example": "speedtest-master.zip"
                    },
                    "expire": {
                        "type": "string",
                        "example": "2026-09-15"
                    }
                },
                "type": "object"
            },
            "ShareInfoData": {
                "properties": {
                    "token": {
                        "description": "OpenAPI 组件：网盘分享信息数据。",
                        "type": "string",
                        "example": "9f86d081884c7d659a2feaa0c55ad015"
                    },
                    "name": {
                        "type": "string",
                        "example": "speedtest-master.zip"
                    },
                    "need_pwd": {
                        "type": "boolean",
                        "example": false
                    },
                    "expired": {
                        "type": "boolean",
                        "example": false
                    }
                },
                "type": "object"
            },
            "ShareListData": {
                "properties": {
                    "shares": {
