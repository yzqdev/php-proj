{
    "name": "yzqde/slim-lab",
    "type": "project",
    "description": "Slim 4 学习演练项目：PHP 特性演示、Doctrine ORM 演示与网盘应用（Redis / Monolog / Swagger）",
    "require": {
        "doctrine/orm": "^3.6",
        "doctrine/dbal": "^4.2",
        "symfony/yaml": "^5.4",
        "symfony/cache": "^5.4",
        "slim/slim": "^4.14",
        "slim/psr7": "^1.7",
        "php-di/php-di": "^7.0",
        "zircote/swagger-php": "^5.0",
        "monolog/monolog": "^3.11",
        "fakerphp/faker": "^1.24",
        "predis/predis": "^3.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Entity\\": "src/Entity/",
            "Service\\": "src/Service/"
        }
    },
    "authors": [
        {
            "name": "yzqdev",
            "email": "yzqdev@outlook.com"
        }
    ]
}
