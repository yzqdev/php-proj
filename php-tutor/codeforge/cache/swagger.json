        "\/pelican": {
            "get": {
                "tags": [
                    "其它"
                ],
                "summary": "鹈鹕骑单车动态 SVG",
                "description": "GET \/pelican — 鹈鹕骑单车动态 SVG",
                "operationId": "53e43eaad2cc68bbd450375b3c50ac74",
                "responses": {
                    "200": {
                        "description": "SVG 图片",
                        "content": {
                            "image\/svg+xml": {}
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "EmptyDataResponse": {
                "required": [
                    "code",
                    "message",
                    "data"
                ],
                "properties": {
                    "code": {
                        "description": "0 表示成功，非 0 为业务错误码",
                        "type": "integer",
                        "example": 0
                    },
                    "message": {
                        "type": "string",
                        "example": " "
                    },
                    "data": {
                        "description": "删除操作不返回数据",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "ErrorResponse": {
                "required": [
                    "code",
                    "message"
                ],
                "properties": {
                    "code": {
                        "description": "业务错误码，与 HTTP 状态码一致",
                        "type": "integer",
                        "example": 404
                    },
                    "message": {
                        "description": "错误提示",
                        "type": "string",
                        "example": "资源不存在"
                    },
                    "data": {
                        "description": "附加信息，无则为 null",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "FileResponse": {
                "required": [
                    "code",
                    "message",
                    "data"
                ],
                "properties": {
                    "code": {
                        "description": "0 表示成功，非 0 为业务错误码",
                        "type": "integer",
                        "example": 0
                    },
                    "message": {
                        "type": "string",
                        "example": "获取成功"
                    },
                    "data": {
                        "$ref": "#\/components\/schemas\/File"
                    }
                },
                "type": "object"
            },
            "File": {
                "required": [
                    "id",
                    "original_name",
                    "extension",
                    "mime",
                    "size",
                    "created_at"
                ],
                "properties": {
                    "id": {
                        "description": "文件记录 ID",
                        "type": "integer",
                        "format": "int64",
                        "example": 1
                    },
                    "original_name": {
                        "description": "上传时的原始文件名",
                        "type": "string",
                        "maxLength": 255,
                        "example": "report.pdf"
                    },
                    "extension": {
                        "description": "扩展名，小写不含点",
                        "type": "string",
                        "example": "pdf"
                    },
                    "mime": {
                        "description": "MIME 类型",
                        "type": "string",
                        "example": "application\/pdf"
                    },
                    "size": {
                        "description": "文件大小，字节",
                        "type": "integer",
                        "format": "int64",
                        "example": 204800
                    },
                    "created_at": {
                        "description": "上传时间，格式 Y-m-d H:i:s",
                        "type": "string",
                        "example": "2026-09-08 14:50:23"
                    }
                },
                "type": "object"
            },
            "FilesPageResponse": {
                "required": [
                    "code",
                    "message",
                    "data"
                ],
                "properties": {
                    "code": {
                        "description": "0 表示成功，非 0 为业务错误码",
                        "type": "integer",
                        "example": 0
                    },
                    "message": {
                        "type": "string",
                        "example": "获取成功"
                    },
                    "data": {
                        "description": "文件记录列表",
                        "type": "array",
                        "items": {
                            "$ref": "#\/components\/schemas\/File"
                        }
                    }
                },
                "type": "object"
            },
            "LogEntry": {
                "required": [
                    "datetime",
                    "level",
                    "channel",
                    "message"
                ],
                "properties": {
                    "datetime": {
                        "description": "ISO-8601 时间戳，带时区",
                        "type": "string",
                        "example": "2026-09-09T01:58:07.333737+08:00"
                    },
                    "level": {
                        "description": "日志级别",
                        "type": "string",
                        "example": "INFO"
                    },
                    "channel": {
                        "description": "日志通道",
                        "type": "string",
                        "example": "app"
                    },
                    "message": {
                        "description": "日志内容",
                        "type": "string",
                        "example": "获取用户列表 [] []"
                    }
                },
                "type": "object"
            },
            "LogsPageResponse": {
                "required": [
                    "code",
                    "message",
                    "data"
                ],
                "properties": {
                    "code": {
                        "description": "0 表示成功，非 0 为业务错误码",
                        "type": "integer",
                        "example": 0
                    },
                    "message": {
                        "type": "string",
                        "example": "获取成功"
                    },
