{
    "openapi": "3.0.0",
    "info": {
        "title": "CodeForge API",
        "description": "CodeForge 是代码托管与文件管理平台，提供用户管理、文件管理、日志查看等能力。\n\n统一响应结构：`{ \"code\": 0, \"message\": \"...\", \"data\": ... }`\n- `code = 0` 表示成功\n- `code > 0` 表示业务错误，取值与 HTTP 状态码一致\n\n开发环境 CORS 默认放行全部来源。",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http:\/\/localhost:6966",
            "description": "本地开发环境"
        }
    ],
    "paths": {
        "\/api\/files": {
            "get": {
                "tags": [
                    "文件"
                ],
                "summary": "获取文件列表",
                "description": "GET \/api\/files — 文件列表\n\n查询参数：limit（可选，1..500，默认 100）",
                "operationId": "c3b214cb03ec61a12c689c4534de75ae",
                "parameters": [
                    {
                        "name": "limit",
                        "in": "query",
                        "description": "返回条数，默认 100，最大 500",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "maximum": 500,
                            "minimum": 1,
                            "example": 100
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "获取成功",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "$ref": "#\/components\/schemas\/FilesPageResponse"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "服务器错误",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "$ref": "#\/components\/schemas\/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "tags": [
                    "文件"
                ],
                "summary": "上传文件",
                "description": "POST \/api\/files — 上传文件\n\n请求体：multipart\/form-data，字段名为 file。",
                "operationId": "4651395956b9ca3aa3ba64d7e49f5b23",
                "requestBody": {
                    "required": true,
                    "content": {
                        "multipart\/form-data": {
                            "schema": {
                                "required": [
                                    "file"
                                ],
                                "properties": {
                                    "file": {
                                        "description": "待上传的文件",
                                        "type": "string",
                                        "format": "binary"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "上传成功",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "$ref": "#\/components\/schemas\/FileResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "缺少 file 字段或文件校验未通过",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "$ref": "#\/components\/schemas\/ErrorResponse"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "服务器错误",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "$ref": "#\/components\/schemas\/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "\/api\/files\/{id}": {
            "get": {
                "tags": [
                    "文件"
                ],
                "summary": "获取文件详情",
                "description": "GET \/api\/files\/{id} — 文件详情",
                "operationId": "7ae6c1bfcd34355a65877f30819a605b",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "文件记录 ID",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "example": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "获取成功",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "$ref": "#\/components\/schemas\/FileResponse"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "文件不存在",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "$ref": "#\/components\/schemas\/ErrorResponse"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "服务器错误",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "$ref": "#\/components\/schemas\/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            },
            "delete": {
                "tags": [
                    "文件"
                ],
                "summary": "删除文件",
                "description": "DELETE \/api\/files\/{id} — 删除文件",
                "operationId": "92895dc994379dceae0b8e68ec44d2bf",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "文件记录 ID",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "example": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "删除成功",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "$ref": "#\/components\/schemas\/EmptyDataResponse"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "文件不存在",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "$ref": "#\/components\/schemas\/ErrorResponse"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "服务器错误",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "$ref": "#\/components\/schemas\/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "\/api\/files\/{id}\/download": {
            "get": {
                "tags": [
                    "文件"
                ],
                "summary": "下载文件",
                "description": "GET \/api\/files\/{id}\/download — 下载文件（流式输出）",
                "operationId": "0a9cad1f397cc164cc798a4454070737",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "文件记录 ID",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "example": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "文件二进制流，Content-Disposition 为 attachment",
                        "headers": {
                            "Content-Disposition": {
                                "schema": {
                                    "type": "string",
                                    "example": "attachment; filename=\"report.pdf\""
                                }
                            }
                        },
                        "content": {
                            "application\/octet-stream": {}
                        }
                    },
                    "404": {
                        "description": "文件不存在或磁盘文件已丢失",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "$ref": "#\/components\/schemas\/ErrorResponse"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "文件读取失败",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "$ref": "#\/components\/schemas\/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "\/api\/logs": {
            "get": {
                "tags": [
                    "日志"
                ],
                "summary": "获取应用日志",
                "description": "GET \/api\/logs — 获取应用日志\n\n查询参数：\n  level 日志级别过滤（INFO \/ WARNING \/ ERROR \/ DEBUG，默认不过滤）\n  limit 返回条数（默认 100，最大 500）\n  date  指定日期 YYYY-MM-DD（默认当天，格式非法时回退到当天）",
                "operationId": "0aa1a8c5b6ee61f1c22bb25143543613",
                "parameters": [
                    {
                        "name": "level",
                        "in": "query",
                        "description": "日志级别过滤，默认不过滤",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "DEBUG",
                                "INFO",
                                "WARNING",
                                "ERROR"
                            ]
                        }
                    },
                    {
                        "name": "limit",
                        "in": "query",
                        "description": "返回条数，默认 100，最大 500",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "maximum": 500,
                            "minimum": 1,
                            "example": 100
                        }
                    },
                    {
                        "name": "date",
                        "in": "query",
                        "description": "指定日期 YYYY-MM-DD，默认当天；格式非法时回退到当天",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                            "example": "2026-09-09"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "获取成功",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "$ref": "#\/components\/schemas\/LogsPageResponse"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "服务器错误",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "$ref": "#\/components\/schemas\/ErrorResponse"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "\/api\/path\/getpath": {
            "get": {
                "tags": [
                    "其它"
                ],
                "summary": "获取配置目录绝对路径",
                "description": "GET \/api\/path\/getpath — 返回配置目录的绝对路径",
                "operationId": "04d0687ebf1d90385ac19fe54c51a0a9",
                "responses": {
                    "200": {
                        "description": "获取成功",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "required": [
                                        "code",
                                        "message",
                                        "data"
                                    ],
                                    "properties": {
                                        "code": {
                                            "type": "integer",
                                            "example": 0
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "获取成功"
                                        },
                                        "data": {
                                            "type": "string",
                                            "example": "F:\\\\PhpStormProjects\\\\php-proj\\\\php-tutor\\\\codeforge\\\\config"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "\/api\/users": {
            "get": {
                "tags": [
