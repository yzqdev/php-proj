# 应用名称(页面标题/导航栏)
APP_NAME=简单图床
# 调试模式:开启后错误响应会附带异常原文,生产环境务必关闭
APP_DEBUG=true
# 单文件上传上限(字节),默认 10 MB
UPLOAD_MAX_SIZE=10485760
# 图片存储目录,相对路径以项目根目录为基准;确保该目录存在写权限且禁止对外执行 PHP
STORAGE_PATH=storage/uploads
# 日志查看接口(/api/logs)是否允许非本机访问;默认仅 127.0.0.1 / ::1 可用,内网或生产调试时置 1
LOG_VIEW_ALLOW_ANY=0
# 数据库(MySQL/MariaDB,Doctrine DBAL 访问);DB_PASSWORD 按本机实际情况填写,禁止提交含真实凭据的 .env
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=playground
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
