# ===== 应用基础 =====
APP_ENV=local
APP_URL=http://localhost:8080
APP_DEBUG=true

# ===== JWT(HS256)=====
# 生产环境务必替换为足够长的随机字符串(建议 >= 32 字符),禁止提交真实密钥
JWT_SECRET=please-change-me-to-a-long-random-string-at-least-32-chars
JWT_ISSUER=blog-api
JWT_TTL=3600

# ===== 数据库 =====
# 驱动:mysql / pgsql / sqlite;sqlite 时 DB_DATABASE 为文件路径或 :memory:
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=blog
DB_USERNAME=root
DB_PASSWORD=

# ===== CORS =====
# 多个来源用英文逗号分隔;开发环境可用 * 表示全部
CORS_ALLOW_ORIGINS=*

# ===== 日志 =====
# debug | info | warning | error
LOG_LEVEL=debug
