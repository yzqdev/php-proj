        "\/api\/v1\/logs\/{date}": {
            "get": {
                "tags": [
                    "Logs"
                ],
                "summary": "日志内容",
                "description": "读取指定日期的日志内容，支持分页和级别过滤",
                "operationId": "c65de0a9bf43b1766bcabcfce2452255",
                "parameters": [
                    {
                        "name": "date",
                        "in": "path",
                        "description": "日期（YYYY-MM-DD）",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "date",
                            "example": "2026-09-09"
                        }
                    },
                    {
                        "name": "offset",
                        "in": "query",
                        "description": "跳过前 N 行",
                        "schema": {
                            "type": "integer",
                            "default": 0
                        }
                    },
                    {
                        "name": "limit",
                        "in": "query",
                        "description": "最多返回 N 行",
                        "schema": {
                            "type": "integer",
                            "default": 500,
                            "maximum": 2000
                        }
                    },
                    {
                        "name": "level",
                        "in": "query",
                        "description": "按级别过滤",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "debug",
                                "info",
                                "notice",
                                "warning",
                                "error",
