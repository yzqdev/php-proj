    "components": {
        "schemas": {
            "Activity": {
                "title": "活动",
                "description": "活动实体；schema 直接定义在 Entity 上（类 playground 的 DTO 注解方式）",
                "properties": {
                    "id": {
                        "type": "integer",
                        "format": "int64",
                        "example": 1
                    },
                    "title": {
                        "description": "活动名称（VARCHAR 120）",
                        "type": "string",
                        "example": "PHP 8.5 技术分享"
                    },
                    "location": {
                        "description": "地点（VARCHAR 120，可空）",
                        "type": "string",
                        "example": "线上直播",
                        "nullable": true
                    },
                    "startTime": {
                        "description": "开始时间（DATETIME，必填）",
                        "type": "string",
                        "format": "date-time",
                        "example": "2026-10-15 19:00:00"
                    },
                    "endTime": {
                        "description": "结束时间（DATETIME，可空）",
                        "type": "string",
                        "format": "date-time",
                        "example": "2026-10-15 21:00:00",
                        "nullable": true
                    },
                    "description": {
                        "description": "活动描述（TEXT，可空）",
                        "type": "string",
                        "example": "深入讲解 PHP 8.5 新特性",
                        "nullable": true
                    },
                    "createdAt": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2026-09-01 09:00:00"
                    },
                    "updatedAt": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2026-09-06 19:00:00"
                    }
                },
                "type": "object"
            },
            "Article": {
                "title": "文章",
