                    {
                        "name": "pageSize",
                        "in": "query",
                        "description": "每页条数",
                        "schema": {
                            "type": "integer",
                            "default": 8,
                            "maximum": 100
                        }
                    },
                    {
                        "name": "upcoming",
                        "in": "query",
                        "description": "传 true 时只返回未来的活动",
                        "schema": {
                            "type": "boolean"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "活动分页列表"
                    }
                }
            },
