        "\/auth\/login": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "登录",
                "description": "用登录名和密码换取 Access + Refresh Token",
                "operationId": "c542ba0f20b129ebb73c48d9561d560b",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application\/json": {
                            "schema": {
                                "required": [
                                    "login",
                                    "password"
                                ],
                                "properties": {
                                    "login": {
                                        "description": "登录名（用户名或邮箱）",
                                        "type": "string",
                                        "example": "admin"
                                    },
                                    "password": {
                                        "description": "密码",
                                        "type": "string",
                                        "format": "password",
                                        "example": "admin123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "登录成功",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "required": [
                                        "accessToken",
                                        "refreshToken"
                                    ],
                                    "properties": {
                                        "accessToken": {
                                            "description": "Access Token（JWT，15 分钟有效）",
                                            "type": "string"
                                        },
                                        "refreshToken": {
                                            "description": "Refresh Token（7 天有效）",
                                            "type": "string"
                                        },
                                        "tokenType": {
                                            "type": "string",
                                            "example": "Bearer"
                                        },
                                        "expiresIn": {
                                            "description": "Access Token 剩余秒数",
                                            "type": "integer",
                                            "example": 900
                                        },
                                        "user": {
                                            "$ref": "#\/components\/schemas\/User"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "账号或密码错误",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "required": [
                                        "code",
                                        "message",
                                        "data"
                                    ],
                                    "properties": {
                                        "code": {
                                            "type": "integer",
                                            "example": 40101
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "账号或密码错误"
                                        },
                                        "data": {
                                            "type": "object",
                                            "nullable": true
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "参数校验失败",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "required": [
                                        "code",
                                        "message",
                                        "data"
                                    ],
                                    "properties": {
                                        "code": {
                                            "type": "integer",
                                            "example": 42201
                                        },
                                        "message": {
                                            "type": "string"
                                        },
                                        "data": {
                                            "description": "字段级错误",
                                            "type": "object",
                                            "nullable": true,
                                            "additionalProperties": {
                                                "type": "array",
                                                "items": {
                                                    "type": "string"
                                                }
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "\/auth\/refresh": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "刷新令牌",
                "description": "用 Refresh Token 换取新的 Access Token（同时轮转 Refresh Token）",
                "operationId": "7f8016872ebe19d2ce467c9feab85394",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application\/json": {
                            "schema": {
                                "required": [
                                    "refreshToken"
                                ],
                                "properties": {
                                    "refreshToken": {
                                        "description": "刷新令牌",
                                        "type": "string"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "刷新成功",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "required": [
                                        "accessToken",
                                        "refreshToken"
                                    ],
                                    "properties": {
                                        "accessToken": {
                                            "description": "新的 Access Token",
                                            "type": "string"
                                        },
                                        "refreshToken": {
                                            "description": "轮转后的新 Refresh Token",
                                            "type": "string"
                                        },
                                        "expiresIn": {
                                            "type": "integer",
                                            "example": 900
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Refresh Token 无效或已过期",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "required": [
                                        "code",
                                        "message",
                                        "data"
                                    ],
                                    "properties": {
                                        "code": {
                                            "type": "integer",
                                            "example": 40102
                                        },
                                        "message": {
                                            "type": "string"
                                        },
                                        "data": {
                                            "type": "object",
                                            "nullable": true
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "\/auth\/logout": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "登出",
                "description": "撤销当前用户的所有 Refresh Token（Access Token 等自然过期）",
                "operationId": "e401b18266e30a630a8c26f097388086",
                "responses": {
                    "204": {
                        "description": "登出成功（无 body）"
                    },
                    "401": {
                        "description": "未登录",
