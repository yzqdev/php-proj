# ============================================================
# .env.example（提交到 Git，供他人参考）
# ============================================================
# 复制成 .env.development 或 .env.production 后按需修改
#
# API 基础路径：
#   - 开发环境（本地后端跨域）：http://127.0.0.1:8000/api/v1
#   - 生产环境（同域名）：/api/v1
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# 调试开关（true / false）
VITE_DEBUG=true
