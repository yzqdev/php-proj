{
  "name": "php-learn-client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "php-learn 前端 SPA（Vue 3 + TS + Vite 8 + Element Plus）",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
