{
    "openapi": "3.0.0",
    "info": {
        "title": "PHP Tutor API",
        "description": "多用户博客系统的 REST API，支持文章、评论和 JWT 认证。\n\n## 认证方式\n\n使用 Bearer Token 认证，在请求头中携带 `Authorization: Bearer <token>`。\n\n## 响应格式\n\n所有 API 响应遵循统一的 JSON 格式：\n```json\n{\n  \"data\": { ... },\n  \"request_id\": \"xxx\"\n}\n```",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http:\/\/localhost:8080",
            "description": "本地开发服务器"
        }
    ],
    "paths": {
        "\/api\/v1\/articles": {
            "get": {
                "tags": [
                    "Articles"
                ],
                "summary": "获取文章列表（分页）",
                "operationId": "9fa68fc97ea24ba8c0a837e1bf9bf2b4",
                "parameters": [
                    {
                        "name": "page",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "default": 1
                        }
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "default": 15
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "成功返回文章列表",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "$ref": "#\/components\/schemas\/ArticleList"
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "tags": [
                    "Articles"
                ],
                "summary": "创建文章（需要 JWT）",
                "operationId": "92a2f8801cbe8b9db8aba5661fb54600",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application\/json": {
                            "schema": {
                                "required": [
                                    "title",
                                    "body"
                                ],
                                "properties": {
                                    "title": {
                                        "type": "string",
                                        "example": "文章标题"
                                    },
                                    "body": {
                                        "type": "string",
                                        "example": "文章内容"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "创建成功",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "$ref": "#\/components\/schemas\/Article"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "验证失败"
                    },
                    "401": {
                        "description": "未认证"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "\/api\/v1\/articles\/{id}": {
            "get": {
                "tags": [
                    "Articles"
                ],
                "summary": "获取单篇文章",
                "operationId": "2c08720fd8099090fb487c36314036e5",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "成功返回文章详情",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "$ref": "#\/components\/schemas\/Article"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "文章不存在"
                    }
                }
            },
            "put": {
                "tags": [
                    "Articles"
                ],
                "summary": "更新文章（需要 JWT）",
                "operationId": "8a4d686d044f99d4969ae0371949385f",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application\/json": {
                            "schema": {
                                "properties": {
                                    "title": {
                                        "type": "string",
                                        "example": "新标题"
                                    },
                                    "body": {
                                        "type": "string",
                                        "example": "新内容"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "更新成功",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "$ref": "#\/components\/schemas\/Article"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "文章不存在"
                    },
                    "401": {
                        "description": "未认证"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "delete": {
                "tags": [
                    "Articles"
                ],
                "summary": "删除文章（需要 JWT）",
                "operationId": "e9e511bc6772ac09752d8e1603a0d024",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "删除成功"
                    },
                    "404": {
                        "description": "文章不存在"
                    },
                    "401": {
                        "description": "未认证"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "\/api\/v1\/auth\/register": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "用户注册",
                "operationId": "0228b9a1bb2c8ea02ed84c1d0c0f9e2c",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application\/json": {
                            "schema": {
                                "required": [
                                    "username",
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "username": {
                                        "type": "string",
                                        "example": "johndoe"
                                    },
                                    "email": {
                                        "type": "string",
                                        "example": "john@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "example": "password123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "注册成功，返回用户信息和 JWT Token",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "$ref": "#\/components\/schemas\/TokenResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "验证失败"
                    }
                }
            }
        },
        "\/api\/v1\/auth\/login": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "用户登录",
                "operationId": "1ce6ca791ed660e4b9556e70cdb40584",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application\/json": {
                            "schema": {
                                "required": [
                                    "username",
                                    "password"
                                ],
                                "properties": {
                                    "username": {
                                        "type": "string",
                                        "example": "johndoe"
                                    },
                                    "password": {
                                        "type": "string",
                                        "example": "password123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "登录成功，返回用户信息和 JWT Token",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "$ref": "#\/components\/schemas\/TokenResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "用户名或密码错误"
                    },
                    "422": {
                        "description": "验证失败"
                    }
                }
            }
        },
        "\/api\/v1\/auth\/refresh": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "刷新 Token",
                "operationId": "fb5da762408592f98a302d7a5c9dfabf",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application\/json": {
                            "schema": {
                                "required": [
                                    "refresh_token"
                                ],
                                "properties": {
                                    "refresh_token": {
                                        "type": "string",
                                        "example": "eyJ0eXAiOiJKV1QiLCJhbGc..."
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "刷新成功，返回新的 Token 对",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "$ref": "#\/components\/schemas\/TokenResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Refresh Token 无效或已过期"
                    }
                }
            }
        },
        "\/api\/v1\/auth\/me": {
            "get": {
                "tags": [
                    "Auth"
                ],
                "summary": "获取当前用户信息",
                "operationId": "92abddce6e0a9d4f8f6ed9d078e44e48",
                "responses": {
                    "200": {
                        "description": "成功返回当前用户信息",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "$ref": "#\/components\/schemas\/User"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "未认证"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "\/api\/v1\/articles\/{id}\/comments": {
            "get": {
                "tags": [
                    "Comments"
                ],
                "summary": "获取文章评论列表（分页）",
                "operationId": "542358ddd40231f2b5a32a21bf56db8e",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "default": 1
                        }
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "default": 15
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "成功返回评论列表",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "$ref": "#\/components\/schemas\/CommentList"
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "tags": [
                    "Comments"
                ],
                "summary": "发表评论（需要 JWT）",
                "operationId": "fb3a908574bf212a2b0367b676ba5e9f",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application\/json": {
                            "schema": {
                                "required": [
                                    "content"
                                ],
                                "properties": {
                                    "content": {
                                        "type": "string",
                                        "example": "这是一条评论"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "评论成功",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "$ref": "#\/components\/schemas\/Comment"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "验证失败"
                    },
                    "401": {
                        "description": "未认证"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "\/api\/v1\/comments\/{id}": {
            "delete": {
                "tags": [
                    "Comments"
                ],
                "summary": "删除评论（需要 JWT）",
                "operationId": "46aa46a14f20613d91f8431ef4c3c9a3",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "删除成功"
                    },
                    "401": {
                        "description": "未认证"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        }
    },
    "components": {
        "schemas": {
            "User": {
                "description": "用户信息",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "username": {
                        "type": "string",
                        "example": "johndoe"
                    },
                    "email": {
                        "type": "string",
                        "example": "john@example.com"
                    },
                    "created_at": {
                        "type": "string",
                        "example": "2024-01-01 00:00:00"
                    },
                    "updated_at": {
                        "type": "string",
                        "example": "2024-01-01 00:00:00"
                    }
                },
                "type": "object"
            },
            "TokenResponse": {
                "description": "登录\/注册\/刷新返回的 Token 响应",
                "properties": {
                    "user": {
                        "$ref": "#\/components\/schemas\/User"
                    },
                    "access_token": {
                        "type": "string",
                        "example": "eyJ0eXAiOiJKV1QiLCJhbGc..."
                    },
                    "refresh_token": {
                        "type": "string",
                        "example": "eyJ0eXAiOiJKV1QiLCJhbGc..."
                    }
                },
                "type": "object"
            },
            "Article": {
                "description": "文章信息",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "title": {
                        "type": "string",
                        "example": "文章标题"
                    },
                    "body": {
                        "type": "string",
                        "example": "文章内容"
                    },
                    "created_at": {
                        "type": "string",
                        "example": "2024-01-01 00:00:00"
                    },
                    "updated_at": {
                        "type": "string",
                        "example": "2024-01-01 00:00:00"
                    },
                    "author": {
                        "properties": {
                            "id": {
                                "type": "integer",
                                "example": 1
                            },
                            "username": {
                                "type": "string",
                                "example": "johndoe"
                            }
                        },
                        "type": "object"
                    }
                },
                "type": "object"
            },
            "ArticleList": {
                "description": "文章列表响应",
                "properties": {
                    "items": {
                        "type": "array",
                        "items": {
                            "$ref": "#\/components\/schemas\/Article"
                        }
                    },
                    "pagination": {
                        "properties": {
                            "current_page": {
                                "type": "integer",
                                "example": 1
                            },
                            "per_page": {
                                "type": "integer",
                                "example": 15
                            },
                            "total": {
                                "type": "integer",
                                "example": 100
                            },
                            "last_page": {
                                "type": "integer",
                                "example": 7
                            }
                        },
                        "type": "object"
                    }
                },
                "type": "object"
            },
            "Comment": {
                "description": "评论信息",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "article_id": {
                        "type": "integer",
                        "example": 1
                    },
                    "content": {
                        "type": "string",
                        "example": "这是一条评论"
                    },
                    "created_at": {
                        "type": "string",
                        "example": "2024-01-01 00:00:00"
                    },
                    "author": {
                        "properties": {
                            "id": {
                                "type": "integer",
                                "example": 1
                            },
                            "username": {
                                "type": "string",
                                "example": "johndoe"
                            }
                        },
                        "type": "object"
                    }
                },
                "type": "object"
            },
            "CommentList": {
                "description": "评论列表响应",
                "properties": {
                    "items": {
                        "type": "array",
                        "items": {
                            "$ref": "#\/components\/schemas\/Comment"
                        }
                    },
                    "pagination": {
                        "properties": {
                            "current_page": {
                                "type": "integer",
                                "example": 1
                            },
                            "per_page": {
                                "type": "integer",
                                "example": 15
                            },
                            "total": {
                                "type": "integer",
                                "example": 50
                            },
                            "last_page": {
                                "type": "integer",
                                "example": 4
                            }
                        },
                        "type": "object"
                    }
                },
                "type": "object"
            }
        },
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "description": "输入 JWT Token（格式：Bearer <token>）",
                "name": "Authorization",
                "in": "header",
                "bearerFormat": "JWT",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "Articles",
            "description": "Articles"
        },
        {
            "name": "Auth",
            "description": "Auth"
        },
        {
            "name": "Comments",
            "description": "Comments"
        }
    ]
}